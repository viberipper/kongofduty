    "encoding": "white on transparent (grey+alpha PNG), all tubes; coverage in alpha"
  },
  "board": {
    "encoding": "unlit housing albedo, sRGB, transparent outside the housing; the sign's tube canvas maps to sign_uv inside it (v down)"
  },
