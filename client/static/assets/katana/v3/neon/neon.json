  "sdf": {
    "encoding": "v = 0.5 + d / (2 * spread), d in canvas px, positive inside the tube; R = tube 0, G = tube 1",
    "spread_px": 32
  },
  "glow": {
    "encoding": "pre-blurred halo of the tube mask (3 lobes scaled to tube width), R = tube 0, G = tube 1, linear 0..1"
  },
