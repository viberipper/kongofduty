{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"],
      "three": ["vendor/three/build/three.module.d.ts"],
      "three/*": ["vendor/three/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "../shared", "vite.config.ts"]
}
